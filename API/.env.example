# Первый запуск с новой БД. После входа владельца удалите обе переменные.
TRIPFLOW_PORTAL_ADMIN_EMAIL=
TRIPFLOW_PORTAL_ADMIN_PASSWORD=

# DeepSeek Flash, Search и Fetch для задач подбора.
DEEPSEEK_API_KEY=

# Geoapify для подсказок, геокодирования и обнаружения отелей.
GEOAPIFY_API_KEY=

# A — базовые пределы. B — дополнительный бюджет для подтверждаемой работы.
HOTEL_SEARCH_PROFILE=B
HOTEL_ENRICHMENT=on

# Необязательно. При пустом DATABASE_URL используется локальная SQLite.
# DATABASE_URL=
# TRIPFLOW_API_PORT=8000
